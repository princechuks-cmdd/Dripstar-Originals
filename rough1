
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dripstar Collection</title>
<style>
  body {
    margin: 0;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    background-color: #1a1a1a;
    color: #fff;
  }

  /* Menu */
  .menu-btn {
    background: #0047AB;
    color: #fff;
    padding: 10px 15px;
    border: none;
    cursor: pointer;
    font-weight: bold;
    position: fixed;
    top: 20px;
    left: 20px;
    z-index: 1100;
  }
  .menu-popup {
    position: fixed;
    top: 0;
    left: -25%;
    width: 25%;
    height: 100%;
    background: #000;
    color: #fff;
    padding: 20px;
    transition: left 0.4s ease;
    z-index: 1000;
  }
  .menu-popup.active { left: 0; }
  .menu-overlay {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(0,0,0,0.5);
    display: none;
    z-index: 999;
  }
  .menu-overlay.active { display: block; }
  .menu-popup a {
    display: block;
    margin: 15px 0;
    color: #fff;
    text-decoration: none;
    font-weight: bold;
  }

  /* Products Grid */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 25px;
    padding: 30px;
  }
  .product {
    background: #222;
    padding: 20px;
    border-radius: 10px;
    text-align: center;
    transition: transform 0.3s;
  }
  .product:hover { transform: translateY(-5px); }
  .product img {
    width: 100%;
    border-radius: 8px;
    cursor: pointer;
  }
  .product-details { margin-top: 10px; }
  .live-viewers {
    font-size: 0.8em;
    color: #ccc;
    margin-bottom: 5px;
  }
  .btn-organic {
    background: #0047AB;
    color: #fff;
    border: none;
    padding: 10px 15px;
    margin-top: 10px;
    cursor: pointer;
    border-radius: 6px;
    font-weight: bold;
  }
  .confirmation {
    margin-top: 8px;
    font-size: 0.9em;
    color: #00ffcc;
    display: none;
  }

  /* Popup Modal */
  .popup {
    display: none;
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(0,0,0,0.8);
    justify-content: center;
    align-items: center;
    z-index: 1200;
  }
  .popup-content {
    background: #fff;
    color: #000;
    padding: 20px;
    border-radius: 10px;
    width: 400px;
    max-height: 90%;
    overflow-y: auto;
  }
  .popup-content img {
    width: 100%;
    border-radius: 8px;
  }
  .close-btn {
    float: right;
    cursor: pointer;
    font-weight: bold;
    color: red;
  }
  .related-products {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 10px;
  }
  .related-products img {
    width: 80px;
    cursor: pointer;
    border-radius: 6px;
  }
</style>
</head>
<body>

<!-- Menu Button -->
<button class="menu-btn" onclick="openMenu()">MENU</button>
<div class="menu-overlay" id="menu-overlay" onclick="closeMenu()"></div>
<div class="menu-popup" id="menu-popup">
  <a href="index.html">Home</a>
  <a href="dripcollection.html">Male Section</a>
  <a href="femalesection.html">Female Section</a>
  <a href="wishlist.html">Wishlist</a>
  <a href="dripAbout.html">About</a>
  <a href="allcart.html">Cart</a>
  <a href="driplogin.html">Login</a>
</div>

<!-- Product Grid -->
<div class="product-grid">
  <div class="product">
    <img src="WhatsApp Image 2026-07-06 at 5.21.15 AM.jpeg" alt="Black MOB-hoodie"
         onclick="openPopup('DSF Black-MOB-hoodie','WhatsApp Image 2026-07-06 at 5.21.15 AM.jpeg','$40')">
    <div class="product-details">
      <div class="live-viewers"><span class="view-count">2</span> people are viewing this right now</div>
      <b>DSF Black-MOB-hoodie</b><br>$40
      <p>Dripstar MOB-hoodie designed in black for maximum comfort, aura and for starz only.</p>
      <button class="btn-organic" onclick="addToCart(this,'DSF Black-MOB-hoodie')">Add to Cart</button>
      <div class="confirmation">This drip has been added to cart</div>
    </div>
  </div>
</div>

<!-- Popup Modal -->
<div class="popup" id="popup">
  <div class="popup-content">
    <span class="close-btn" onclick="closePopup()">X</span>
    <h3 id="popup-title"></h3>
    <img id="popup-img" src="" alt="">
    <p id="popup-price"></p>
    <label>Size:
      <select><option>S</option><option>M</option><option>L</option></select>
    </label><br><br>
    <label>Color:
      <select><option>Black</option><option>White</option><option>Blue</option></select>
    </label><br><br>
    <label>Quantity:
      <input type="number" value="1" min="1">
    </label><br><br>
    <h4>Related Products</h4>
    <div class="related-products">
      <img src="blacoo - Copy.jpeg" alt="DSF Black-Drip-cap"
           onclick="openPopup('DSF Black-Drip-cap','blacoo - Copy.jpeg','$7')">
      <img src="male1 front.jpeg" alt="DSF Los Angeles Polo"
           onclick="openPopup('DSF Los Angeles Polo','male1 front.jpeg','$25')">
    </div>
  </div>
</div>

<script>
  function openMenu() {
    document.getElementById('menu-popup').classList.add('active');
    document.getElementById('menu-overlay').classList.add('active');
  }
  function closeMenu() {
    document.getElementById('menu-popup').classList.remove('active');
    document.getElementById('menu-overlay').classList.remove('active');
  }

  function openPopup(title, img, price) {
    document.getElementById('popup-title').innerText = title;
    document.getElementById('popup-img').src = img;
    document.getElementById('popup-price').innerText = price;
    document.getElementById('popup').style.display = 'flex';
  }
  function closePopup() {
    document.getElementById('popup').style.display = 'none';
  }

  function addToCart(btn, productName) {
    const confirmation = btn.nextElementSibling;
    confirmation.style.display = 'block';
    setTimeout(() => { confirmation.style.display = 'none'; }, 2000);
  }
</script>

</body>
</html>